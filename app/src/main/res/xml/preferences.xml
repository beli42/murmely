<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_category_saving">

        <Preference
            app:iconSpaceReserved="false"
            app:key="save_location_current"
            app:selectable="false"
            app:title="@string/save_location_current" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="save_folder_pick"
            app:summary="@string/save_folder_pick_summary"
            app:title="@string/save_folder_pick" />

        <ListPreference
            app:defaultValue="png"
            app:entries="@array/save_format_entries"
            app:entryValues="@array/save_format_values"
            app:iconSpaceReserved="false"
            app:key="save_format"
            app:title="@string/save_format"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:max="100"
            app:defaultValue="93"
            app:iconSpaceReserved="false"
            app:key="save_jpeg_quality"
            app:min="10"
            app:showSeekBarValue="true"
            app:summary="@string/save_jpeg_quality_summary"
            app:title="@string/save_jpeg_quality" />
    </PreferenceCategory>
</PreferenceScreen>
