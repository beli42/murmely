<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable list of adjustment sliders. Each row: label, slider, current value.
     Double-tap a slider (or tap its value) to reset it to zero. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SliderFragment">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:shrinkColumns="0"
        android:stretchColumns="1">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/label_exposure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/lbl_exposure" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_exposure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/value_exposure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="end"
                android:minWidth="40dp"
                android:padding="4dp"
                android:textSize="12sp"
                tools:text="+35" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
